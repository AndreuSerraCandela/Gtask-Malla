  <Code>Public Function BlankZero(ByVal Value As Decimal)
    Return Value
End Function

Public Function DispDateOrDash(ByVal Value As Object) As String
    If Value Is Nothing Then Return "(—)"
    Dim s As String = Convert.ToString(Value)
    If String.IsNullOrWhiteSpace(s) OrElse s = "1900-01-01" Then Return "(—)"
    Dim d As DateTime
    If DateTime.TryParse(s, d) Then
        Return d.ToString("dd/MM/yyyy")
    Else
        Return "(—)"
    End If
End Function

Public Function BoolSiNo(ByVal Value As Object) As String
    If Value Is Nothing Then Return "(—)"
    If TypeOf Value Is Boolean Then
        If DirectCast(Value, Boolean) Then
            Return "Sí"
        Else
            Return "No"
        End If
    End If
    Return Convert.ToString(Value)
End Function

Public Function FmtDecimal(ByVal Value As Object) As String
    If Value Is Nothing Then Return ""
    Dim d As Decimal = 0D
    Dim s As String = Convert.ToString(Value, System.Globalization.CultureInfo.InvariantCulture)
    If String.IsNullOrWhiteSpace(s) Then Return ""
    If Decimal.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, d) Then
        Return d.ToString("N2")
    Else
        Return Convert.ToString(Value)
    End If
End Function
</Code>
