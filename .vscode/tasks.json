{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "AL: Build y copiar .app",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/Build-And-CopyAppToMalla.ps1",
                "-WorkspaceFolder",
                "${workspaceFolder}"
            ],
            "problemMatcher": "$al",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            }
        },
        {
            "label": "Copiar .app a Malla",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/Build-And-CopyAppToMalla.ps1",
                "-WorkspaceFolder",
                "${workspaceFolder}",
                "-CopyOnly"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "AL: Recargar proyecto (limpiar caché)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/Reload-AlProject.ps1",
                "-WorkspaceFolder",
                "${workspaceFolder}"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            }
        }
    ]
}
